# ---------------------------------------------------------------------------
# Octave Chime / Aster Bank — environment template.
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Neon Postgres (new dedicated database). Use the pooled connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Twilio WhatsApp Sandbox. Account SID + Auth Token from the Twilio Console.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_your_auth_token

# Sandbox WhatsApp sender, e.g. whatsapp:+14155238886 (the console shows yours).
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Public HTTPS base URL of this app (required for Twilio signature validation
# and status callbacks). Locally leave blank; on Vercel set the deployment URL.
PUBLIC_URL=

# Optional: explicit status-callback URL. Defaults to PUBLIC_URL + /api/twilio/status.
TWILIO_STATUS_CALLBACK_URL=

# Content Template SID (HX...) created in Twilio Console > Content Template Builder.
# Needed because Twilio now requires templates for business-initiated WhatsApp
# messages outside the 24h freeform window. When set, all alerts send as this
# template with the message text injected into placeholder {{1}}.
TWILIO_CONTENT_SID=

# End-of-day summary schedule.
EOD_HOUR=18
EOD_TZ=Africa/Lagos

PORT=3000
